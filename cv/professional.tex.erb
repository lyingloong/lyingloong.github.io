\begin{resumeSection}{<%= tex(skills_section.first) %>}
  \begin{tabular}{@{}>{\bfseries}l@{\hspace{6ex}}l}
<% skill_rows.each_with_index do |(label, text), index| -%>
    <%= inline_tex(label) %> & <%= inline_tex(text) %><%= '\\' * 2 if index < skill_rows.length - 1 %>
<% end -%>
  \end{tabular}
\end{resumeSection}

<% unless publications.empty? -%>
\begin{resumeSection}{<%= tex(publication_section.first) %>}
<% publications.each do |authors, *citation| -%>
  <%= inline_tex(authors) %> \\
  <%= inline_link_group(citation.join(" ")) %>
  \par
<% end -%>
\end{resumeSection}
<% end -%>

<%= experience_tex -%>

\begin{resumeSection}[5]{<%= tex(recent_section.first) %>}
<% contributions.each do |contribution| -%>
  \needspace{3\baselineskip}
  \textbf{<%= inline_tex(contribution.fetch("title")) %>}\enspace
  <%= inline_tex(contribution.fetch("description")) %>
<% unless contribution.fetch("links").empty? -%>
  \enspace <%= contribution.fetch("links").map { |entry| inline_tex(entry) }.join(' \enspace ') %>
<% end -%>
  \par
<% end -%>
\end{resumeSection}

\begin{resumeSection}{<%= tex(award_section.first) %>}
  <%= awards.map { |award| inline_tex(award) }.join("\\\\\n  ") %>
\end{resumeSection}

