\begin{resumeSection}[5]{Recent Projects and Open Source Contributions}
<% projects.each do |project| -%>
<% project_links = { "Project" => project["website_url"], "Code" => project["source_url"], "Steam" => project["steam_url"] }.compact -%>
  \needspace{3\baselineskip}
  \textbf{<%= tex(project.fetch("title")) %>}\enspace
  <%= tex(text(project.fetch("description"))) %>
<% unless project_links.empty? -%>
  \enspace <%= links(project_links) %>
<% end -%>
<% if project["display_date"] -%>
  \enspace (<%= tex(project["display_date"]) %>)
<% end -%>
  \par

<% end -%>
<% cv.fetch("open_source_contributions").each do |contribution| -%>
  \needspace{3\baselineskip}
  \textbf{<%= tex(contribution.fetch("title")) %>}\enspace
  <%= tex(contribution.fetch("description")) %>\enspace
  <%= links(contribution.fetch("links")) %>
  \par
<% end -%>
\end{resumeSection}

\begin{resumeSection}{Awards}
  <%= honors.map { |award| tex(award.fetch("title")) + "（#{tex(award.fetch("date"))}）" }.join("\\\\\n  ") %>
