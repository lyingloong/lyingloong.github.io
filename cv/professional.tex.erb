<% unless publications.empty? -%>
\begin{resumeSection}{Publications}
<% publications.each do |paper| -%>
<% author_names = paper.fetch("authors").map { |name| name == profile.fetch("primary_name") ? "\\textbf{#{tex(name)}}" : tex(name) } -%>
  <%= author_names.join(", ") %>. \\
  \textit{<%= tex(paper.fetch("title")) %>}.
  <%= tex(paper.fetch("pub")) %>, <%= tex(paper.fetch("pub_date") { year(paper.fetch("date")) }) %>.
  <%= links(paper.fetch("links", {})) %>
  \par
<% end -%>
\end{resumeSection}
<% end -%>

