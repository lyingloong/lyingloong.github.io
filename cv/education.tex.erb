\documentclass{resume}
\usepackage[fontset=fandol]{ctex}
\usepackage{graphicx}
\usepackage{tikz}
\linespread{1.16}

\newlength{\educationMargin}
\setlength{\educationMargin}{14mm}
\geometry{a4paper,left=\educationMargin,right=\educationMargin,top=16mm,bottom=16mm}
\definecolor{resumeAccent}{HTML}{234359}
\definecolor{educationInk}{HTML}{26343A}
\definecolor{educationMuted}{HTML}{556871}
\definecolor{educationHeaderText}{HTML}{E4EDF3}
\definecolor{educationCard}{HTML}{EBF1F4}
\definecolor{educationRule}{HTML}{C8D6DF}
\usepackage[colorlinks,allcolors=resumeAccent]{hyperref}
\raggedbottom

\newcommand{\educationSection}[1]{%
  \par\addvspace{9mm}%
  {\rmfamily\songti\Large\bfseries\color{resumeAccent}#1\par}%
  \nobreak\vspace{1mm}%
  {\color{resumeAccent}\hrule height 0.6pt}%
  \nobreak\vspace{5mm}%
}

\begin{document}
\sffamily\color{educationInk}
\setlength{\parfillskip}{0pt plus 1fil}
\begingroup
\setlength{\fboxsep}{0pt}
\hypersetup{urlcolor=educationHeaderText}
% Extend the first-page banner into the top margin.
\vspace*{\dimexpr-16mm-\topskip\relax}
\nointerlineskip
{\setlength{\parskip}{0pt}\noindent}%
\makebox[0pt][l]{\hspace*{-\educationMargin}%
  \colorbox{resumeAccent}{%
    \begin{minipage}[c][61mm][c]{\paperwidth}
      \noindent\hspace*{\educationMargin}%
      \begin{minipage}[c]{0.64\paperwidth}
        \raggedright\color{educationHeaderText}
        {\kaishu\color{white}\fontsize{38}{43}\selectfont
          <%= tex(name) %>\par}
        \medskip
        {\large <%= inline_tex(affiliation) %>\par}
        \medskip
<% education_contacts.each_with_index do |entry, index| -%>
<% if index.zero? -%>
        {\small <%= inline_tex(entry) %>\par}
<% else -%>
        <%= inline_tex(entry) %>\par
<% end -%>
<% end -%>
      \end{minipage}\hfill
<% if education_photo -%>
      \begin{tikzpicture}[baseline=(portrait.center)]
        \node[rounded corners=4pt, fill=white, draw=educationRule, inner sep=2.5pt] (portrait)
          {\includegraphics[width=34mm]{\detokenize{<%= education_photo %>}}};
      \end{tikzpicture}%
<% end -%>
      \hspace*{\educationMargin}%
    \end{minipage}%
  }%
}\par
\endgroup

\educationSection{<%= inline_tex(education_section.first) %>}
\noindent\begin{tikzpicture}
  \node[anchor=north west, inner sep=0pt] at (0,0) {%
    \begin{minipage}[t]{0.49\linewidth}
      \raggedright
      \setlength{\parskip}{7pt}
      {\large\bfseries <%= inline_tex(undergraduate.fetch("title")) %>%
<% if undergraduate["logo"] -%>
        \hspace{3mm}\raisebox{-0.3\height}[0pt][0pt]{%
          \includegraphics[width=9mm]{\detokenize{<%= undergraduate.fetch("logo") %>}}}%
<% end -%>
        \par}
<% undergraduate.fetch("lines").each do |line| -%>
<% if line.start_with?("GPA ") -%>
      {\bfseries\color{resumeAccent}<%= inline_tex(line) %>\par}
<% elsif line.match?(/\A\d{4} 年/) -%>
      {\color{educationMuted}<%= inline_tex(line) %>\par}
<% else -%>
      <%= inline_tex(line) %>\par
<% end -%>
<% end -%>
    \end{minipage}%
  };
  \node[anchor=north west, inner sep=0pt] (graduate) at (0.56\linewidth,0) {%
    \begin{minipage}[t]{0.44\linewidth}
      \raggedright
      \setlength{\parskip}{7pt}
      {\large\bfseries <%= inline_tex(graduate.fetch("title")) %>\par}
<% graduate.fetch("lines").each do |line| -%>
<% if line.match?(/\A\d{4} 年/) -%>
      {\color{educationMuted}<%= inline_tex(line) %>\par}
<% else -%>
      <%= inline_tex(line) %>\par
<% end -%>
<% end -%>
    \end{minipage}%
  };
  \draw[educationRule, line width=0.6pt]
    ([xshift=-7mm]graduate.north west) -- ([xshift=-7mm]graduate.south west);
\end{tikzpicture}\par

\educationSection{<%= inline_tex(gaokao_section.first) %>}
\noindent\begin{tikzpicture}
  \node[rounded corners=5pt, fill=educationCard, inner xsep=12pt, inner ysep=15pt] {%
    \begin{minipage}{\dimexpr\linewidth-24pt\relax}
      \begin{minipage}[c]{0.24\linewidth}
        \raggedright
        {\small\color{educationMuted}<%= inline_tex(gaokao_caption) %>\par}
        \smallskip
        {\rmfamily\bfseries\color{resumeAccent}%
          {\fontsize{32}{34}\selectfont <%= tex(gaokao_total) %>}%
          {\large /<%= tex(gaokao_max) %>}\par}
      \end{minipage}\hfill
      \begin{minipage}[c]{0.72\linewidth}
        \raggedright
        \setlength{\parskip}{7pt}
        {\large\bfseries\color{resumeAccent}<%= inline_tex(gaokao_rank) %>\par}
        \smallskip
        \renewcommand{\arraystretch}{1.5}%
        \begin{tabular}{@{}l@{\hspace{1em}}l@{\hspace{1em}}l@{}}
<% gaokao_subjects.each_slice(3) do |subjects| -%>
          <%= subjects.map { |subject| inline_tex(subject) }.join(' & ') %> \\
<% end -%>
        \end{tabular}\par
      \end{minipage}
    \end{minipage}%
  };
\end{tikzpicture}\par

<% unless teaching_entries.empty? -%>
\needspace{6\baselineskip}
\educationSection{<%= inline_tex(teaching_section.first) %>}
<% unless teaching_summary.empty? -%>
<%= inline_tex(teaching_summary) %>\par
<% end -%>
\begingroup
\setlength{\leftskip}{20pt}
\setlength{\parskip}{4pt}
<% teaching_entries.each do |entry| -%>
<% metadata = [entry.fetch("date"), entry.fetch("location")].reject(&:empty?) -%>
  \addvspace{4mm}
  \needspace{4\baselineskip}
  \noindent\llap{\textcolor{resumeAccent}{\large\textbullet}\hspace{9pt}}%
  {\large\bfseries <%= inline_tex(entry.fetch("title")) %>\par}
  \nobreak
<% unless metadata.empty? -%>
  {\color{educationMuted}<%= inline_tex(metadata.join(" · ")) %>\par}
  \nobreak
<% end -%>
<% entry.fetch("highlights").each do |highlight| -%>
  <%= inline_tex(highlight) %>\par
<% end -%>
<% end -%>
\endgroup
<% end -%>
\end{document}
