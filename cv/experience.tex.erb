<% experience_sections.each do |heading, roles| -%>
<% next if roles.empty? -%>
\begin{resumeSection}[6]{<%= tex(heading) %>}
<% roles.each do |entry| -%>
  \begin{resumeEntry}
    {<%= inline_tex(entry.fetch("title")) %>}
    {<%= inline_tex(entry.fetch("date")) %>}
    {<%= inline_tex(entry.fetch("location")) %>}
<% entry.fetch("highlights").each do |highlight| -%>
    \item <%= inline_tex(highlight) %>
<% end -%>
  \end{resumeEntry}

<% end -%>
\end{resumeSection}

<% end -%>
