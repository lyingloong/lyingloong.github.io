% Source: https://www.LaTeXTemplates.com

\documentclass{resume}
\usepackage{ctex}
\linespread{1.16}
\usepackage[colorlinks,allcolors=resumeAccent]{hyperref}

\name{<%= tex(name) %>}
\address{<%= inline_tex(affiliation) %>}
\address{<%= contacts.map { |entry| inline_tex(entry) }.join(" \\\\ ") %>}

\begin{document}
\makeresumeheader

\begin{resumeSection}{<%= tex(education_section.first) %>}
<% education_entries.each do |degree, date, *details| -%>
  <%= inline_link_group(degree, first_separator: '\enspace ') %>
  \hfill <%= inline_tex(date) %>
<% details.each do |detail| -%>
  \\
  <%= inline_tex(detail) %>
<% end -%>
  \par
<% end -%>
\end{resumeSection}

<%= content -%>
\end{document}
